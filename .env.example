PORT=3001
DATABASE_ADAPTER=sqlite
BELLIA_SQLITE_PATH=./data/bellia.db
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD

# Para usar Oracle, cambia DATABASE_ADAPTER a oracle y ejecuta primero server/db/schema.oracle.sql:
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_CONNECT_STRING=host:1521/service

# Para usar Postgres, cambia DATABASE_ADAPTER a postgres y ejecuta primero server/db/schema.postgres.sql.
# Usa DATABASE_URL o las variables POSTGRES_*:
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
